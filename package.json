{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run evaluate && npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate": "vite-node --config vitest.config.js evaluation/run-evaluation.js",
