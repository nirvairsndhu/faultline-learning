    "demo:verify": "npm run check"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@xyflow/react": "^12.8.2",
    "motion": "^12.23.12",
    "next": "^15.4.6",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.4.6",
    "vitest": "^3.2.4"
  }
}
